# yorhamc.com 中转网关(OpenAI 兼容协议)
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://yorhamc.com/v1

# 模型档位(参考 PLAN.md 第二章)
PRIMARY_MODEL=deepseek-v4-pro-max
FAST_MODEL=deepseek-v4-flash
VISION_MODEL=gemini-3.1-flash-lite
FALLBACK_MODEL=claude-sonnet-4-6

# GitHub Token(读公开 PR 不需要,读私有/规避 rate limit 需要)
GITHUB_TOKEN=

# 后端
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# 数据库
DATABASE_URL=sqlite:///./data/cache.db
