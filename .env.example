# your-gateway.example.com 中转网关(OpenAI 兼容协议)
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://https://your-gateway.example.com/v1

# 模型
PRIMARY_MODEL=deepseek-v4-pro-max
VISION_MODEL=gemini-3.1-flash-lite

# GitHub Token(读公开 PR 不需要,读私有/规避 rate limit 需要)
GITHUB_TOKEN=

# GitHub 镜像站(国内服务器无法直连 github.com 时使用)
# 默认用 kkgithub.com 镜像,如果你的服务器能直连 github 可改回官方:
# GITHUB_API_BASE=https://api.github.com
# GITHUB_RAW_BASE=https://raw.githubusercontent.com
GITHUB_API_BASE=https://api.github.com
GITHUB_RAW_BASE=https://raw.githubusercontent.com

# 后端
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# CORS:逗号分隔的来源(精确匹配)+ 可选正则(用于 Vercel 预览域)
# 例如:CORS_ORIGINS=["https://your-app.vercel.app","http://localhost:3000"]
# CORS_ORIGIN_REGEX="https://.*\.vercel\.app"

# 评审结果缓存(SQLite,key = repo + head_sha + strategy + model)
CACHE_ENABLED=true
CACHE_DB_PATH=./data/cache.db
